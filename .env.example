# ── banco ─────────────────────────────────────────────────────────────────────
POSTGRES_USER=fireshot
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=fireshot
DATABASE_URL=postgresql+asyncpg://fireshot:troque-esta-senha@db:5432/fireshot

# ── autenticação ──────────────────────────────────────────────────────────────
# openssl rand -hex 32 — com COOKIE_SECURE=true a API não sobe com segredo padrão ou menor que 32 caracteres
JWT_SECRET=troque-por-32-bytes-aleatorios
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=7
COOKIE_SECURE=true          # false para rodar em http://localhost
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=fireshotgame.io

# ── limites ───────────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=10
API_RATE_LIMIT=120
TRUST_PROXY=true            # atrás do nginx do compose
# MAX_BODY_BYTES=524288     # corpo máximo aceito pela API
# LOGIN_MAX_FAILURES=10     # senhas erradas seguidas por e-mail antes de travar o login…
# LOGIN_LOCK_MINUTES=15     # …por este tempo (a trava fica no banco e vale entre instâncias)
# API_DOCS=false            # Swagger em /api/docs; fora de produção (COOKIE_SECURE=false) fica sempre ligado
# DATABASE_SSL_VERIFY=true  # com TLS, confere certificado e hostname do banco

# ── certificado ───────────────────────────────────────────────────────────────
ISSUER_NAME=Fireshot: Defesa de Rede
VERIFY_BASE_URL=http://localhost:8080/verificar
# openssl genpkey -algorithm ed25519 -out infra/cert-key.pem
CERT_PRIVATE_KEY_FILE=/run/secrets/cert-key.pem
CERT_MIN_ACTIVE_HOURS=3
CERT_MIN_ACCURACY=0.70

# porta em que o nginx do compose publica o jogo
WEB_PORT=8080

# ── testes ────────────────────────────────────────────────────────────────────
# TEST_DATABASE_URL=postgresql+asyncpg://fireshot:fireshot@localhost:55432/fireshot
