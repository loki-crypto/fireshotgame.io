{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase.schema.json",
  "title": "Fase",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "order", "title", "subtitle", "concepts", "learningObjectives", "briefing", "debriefing", "parTime", "minTime", "limits", "tags", "weaponsAvailable", "layout", "legend", "terminals", "exit"],
  "$defs": {
    "cell": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 2, "maxItems": 2 },
    "effect": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        { "properties": { "type": { "const": "openDoor" }, "door": { "type": "string" } }, "required": ["door"], "additionalProperties": false },
        { "properties": { "type": { "const": "closeDoor" }, "door": { "type": "string" } }, "required": ["door"], "additionalProperties": false },
        { "properties": { "type": { "const": "disableSpawner" }, "spawner": { "type": "string" } }, "required": ["spawner"], "additionalProperties": false },
        { "properties": { "type": { "const": "enableSpawner" }, "spawner": { "type": "string" } }, "required": ["spawner"], "additionalProperties": false },
        { "properties": { "type": { "const": "setFlag" }, "flag": { "type": "string" } }, "required": ["flag"], "additionalProperties": false },
        { "properties": { "type": { "const": "message" }, "text": { "type": "string", "minLength": 1 }, "tone": { "enum": ["info", "warn", "success"] } }, "required": ["text"], "additionalProperties": false },
        { "properties": { "type": { "const": "spawnPickups" }, "kind": { "$ref": "#/$defs/pickupKind" }, "spawner": { "type": "string" }, "count": { "type": "integer", "minimum": 1 }, "amount": { "type": "number" } }, "required": ["kind", "spawner", "count"], "additionalProperties": false },
        { "properties": { "type": { "const": "spawnEnemies" }, "enemy": { "type": "string" }, "spawner": { "type": "string" }, "count": { "type": "integer", "minimum": 1 } }, "required": ["enemy", "spawner", "count"], "additionalProperties": false },
        { "properties": { "type": { "const": "applyFirewallRules" } }, "additionalProperties": false }
      ]
    },
    "pickupKind": { "enum": ["ammo", "health", "shield", "bytes", "backup", "energy"] },
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultPolicy", "rules"],
      "properties": {
        "defaultPolicy": { "enum": ["allow", "deny"] },
        "rules": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["port", "action"], "properties": { "port": { "type": "integer", "minimum": 0, "maximum": 65535 }, "action": { "enum": ["allow", "deny"] } } } }
      }
    }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "order": { "type": "integer", "minimum": 0 },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" },
    "concepts": { "type": "array", "items": { "type": "string" } },
    "learningObjectives": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "briefing": {
      "type": "object", "additionalProperties": false, "required": ["lines"],
      "properties": { "lines": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["speaker", "text"], "properties": { "speaker": { "type": "string" }, "text": { "type": "string", "minLength": 1 } } } } }
    },
    "debriefing": { "type": "object", "additionalProperties": false, "required": ["summary"], "properties": { "summary": { "type": "array", "items": { "type": "string" }, "minItems": 1 } } },
    "parTime": { "type": "number", "exclusiveMinimum": 0 },
    "minTime": { "type": "number", "minimum": 0 },
    "limits": { "type": "object", "additionalProperties": false, "required": ["maxKills", "maxBytes"], "properties": { "maxKills": { "type": "integer", "minimum": 0 }, "maxBytes": { "type": "integer", "minimum": 0 } } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "weaponsAvailable": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "introducesWeapon": { "type": "string" },
    "introducesEnemies": { "type": "array", "items": { "type": "string" } },
    "ambient": { "type": "object", "additionalProperties": false, "properties": { "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }, "fogDensity": { "type": "number", "minimum": 0 } } },
    "layout": {
      "type": "object", "additionalProperties": false, "required": ["cellSize", "wallHeight", "rows"],
      "properties": {
        "cellSize": { "type": "number", "exclusiveMinimum": 0 },
        "wallHeight": { "type": "number", "exclusiveMinimum": 2 },
        "rows": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 3 } }
      }
    },
    "legend": {
      "type": "object",
      "propertyNames": { "minLength": 1, "maxLength": 1, "not": { "enum": ["#", ".", " "] } },
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "oneOf": [
          { "properties": { "type": { "const": "player" } }, "additionalProperties": false },
          { "properties": { "type": { "const": "door" }, "id": { "type": "string" } }, "required": ["id"], "additionalProperties": false },
          { "properties": { "type": { "const": "terminal" }, "id": { "type": "string" } }, "required": ["id"], "additionalProperties": false },
          { "properties": { "type": { "const": "enemy" }, "enemy": { "type": "string" }, "route": { "type": "string" } }, "required": ["enemy"], "additionalProperties": false },
          { "properties": { "type": { "const": "spawner" }, "id": { "type": "string" } }, "required": ["id"], "additionalProperties": false },
          { "properties": { "type": { "const": "pickup" }, "kind": { "$ref": "#/$defs/pickupKind" }, "amount": { "type": "number" }, "fake": { "type": "boolean" } }, "required": ["kind"], "additionalProperties": false },
          { "properties": { "type": { "const": "arena" }, "id": { "type": "string" } }, "required": ["id"], "additionalProperties": false },
          { "properties": { "type": { "const": "exit" } }, "additionalProperties": false },
          { "properties": { "type": { "const": "vault" }, "id": { "type": "string" } }, "required": ["id"], "additionalProperties": false },
          { "properties": { "type": { "const": "sign" }, "text": { "type": "string", "minLength": 1 } }, "required": ["text"], "additionalProperties": false },
          { "properties": { "type": { "const": "trigger" }, "id": { "type": "string" } }, "required": ["id"], "additionalProperties": false }
        ]
      }
    },
    "routes": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/cell" }, "minItems": 1 } },
    "terminals": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "concept", "generator", "challenges", "required", "onSolve"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "minLength": 1, "maxLength": 24 },
          "concept": { "type": "string", "minLength": 1 },
          "generator": { "type": "string" },
          "params": { "type": "object" },
          "challenges": { "type": "integer", "minimum": 1, "maximum": 10 },
          "required": { "type": "boolean" },
          "requires": { "type": "array", "items": { "type": "string" } },
          "onSolve": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
          "hint": { "type": "string" }
        }
      }
    },
    "spawners": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id"],
        "properties": {
          "id": { "type": "string" }, "enemy": { "type": "string" }, "every": { "type": "number", "exclusiveMinimum": 0 },
          "max": { "type": "integer", "minimum": 1 }, "active": { "type": "boolean" }, "traffic": { "type": "integer", "minimum": 0, "maximum": 65535 }
        }
      }
    },
    "arenas": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "title", "waves", "onClear"],
        "properties": {
          "id": { "type": "string" }, "title": { "type": "string" },
          "lockDoors": { "type": "array", "items": { "type": "string" } },
          "waves": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["spawns"],
              "properties": {
                "spawns": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["spawner", "enemy", "count"], "properties": { "spawner": { "type": "string" }, "enemy": { "type": "string" }, "count": { "type": "integer", "minimum": 1 }, "interval": { "type": "number", "minimum": 0 }, "traffic": { "type": "integer" } } } },
                "delayAfter": { "type": "number", "minimum": 0 },
                "message": { "type": "string" }
              }
            }
          },
          "onClear": { "type": "array", "items": { "$ref": "#/$defs/effect" } }
        }
      }
    },
    "vaults": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "crackAttempts", "reward"], "properties": { "id": { "type": "string" }, "crackAttempts": { "type": "integer", "minimum": 1 }, "reward": { "type": "object", "additionalProperties": false, "required": ["bytes"], "properties": { "bytes": { "type": "integer", "minimum": 0 } } } } } },
    "triggers": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "effects"], "properties": { "id": { "type": "string" }, "once": { "type": "boolean" }, "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } } } } },
    "exit": {
      "type": "object", "additionalProperties": false, "required": ["requires"],
      "properties": { "requires": { "type": "object", "additionalProperties": false, "properties": { "terminals": { "type": "array", "items": { "type": "string" } }, "arenas": { "type": "array", "items": { "type": "string" } }, "bossDefeated": { "type": "boolean" }, "flags": { "type": "array", "items": { "type": "string" } } } } }
    },
    "firewall": { "type": "object", "additionalProperties": false, "required": ["initial"], "properties": { "initial": { "$ref": "#/$defs/ruleset" } } },
    "messages": { "type": "object", "additionalProperties": false, "properties": { "legitEvery": { "type": "number", "exclusiveMinimum": 0 }, "maxActive": { "type": "integer", "minimum": 1 } } }
  }
}
